{
  "name": "KPI",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "KPI name (e.g., SLA Adherence, Ticket Resolution Time)"
    },
    "description": {
      "type": "string",
      "description": "What this KPI measures and why it matters"
    },
    "department": {
      "type": "string",
      "description": "Department or business unit this KPI belongs to"
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the user who owns this KPI. When set, scopes the KPI to that individual (team-scoped when the owner is a team member). Null/omitted for org-wide shared KPIs."
    },
    "current_value": {
      "type": "number",
      "description": "Current actual value of the KPI"
    },
    "target_value": {
      "type": "number",
      "description": "Target value for the KPI"
    },
    "unit": {
      "type": "string",
      "description": "Unit of measurement (%, hrs, count, $, etc.)"
    },
    "direction": {
      "type": "string",
      "enum": [
        "higher_better",
        "lower_better",
        "maintain"
      ],
      "default": "higher_better",
      "description": "Whether higher values are better, lower is better, or maintain"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "archived",
        "achieved"
      ],
      "default": "active",
      "description": "Current status of this KPI"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "default": "shared",
      "description": "Visibility setting"
    },
    "linked_goal_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of Goals this KPI supports or aligns with"
    },
    "cascaded_from_kpi_id": {
      "type": "string",
      "description": "ID of the parent KPI this was cascaded from (for org-level cascading)"
    },
    "progress": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "default": 0,
      "description": "Computed progress percentage towards target"
    },
    "client_id": {
      "type": "string",
      "description": "Client ID for multi-tenant support"
    },
    "points_value": {
      "type": "number",
      "description": "Gamification points for achieving this KPI"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.visibility": "shared"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "User Level 2"
              }
            },
            {
              "$or": [
                {
                  "data.owner_email": "{{user.email}}"
                },
                {
                  "data.owner_email": {
                    "$in": "{{user.data.subordinate_emails}}"
                  }
                }
              ]
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "Analyst"
                  }
                },
                {
                  "user_condition": {
                    "role": "Admin Level 1"
                  }
                },
                {
                  "user_condition": {
                    "role": "Admin Level 2"
                  }
                },
                {
                  "user_condition": {
                    "role": "Super Administrator"
                  }
                }
              ]
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": null,
    "delete": null
  }
}