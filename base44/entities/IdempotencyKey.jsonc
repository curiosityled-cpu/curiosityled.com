{
  "name": "IdempotencyKey",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant ID"
    },
    "endpoint": {
      "type": "string",
      "description": "API endpoint"
    },
    "key": {
      "type": "string",
      "description": "Idempotency key"
    },
    "request_hash": {
      "type": "string",
      "description": "Hash of request body"
    },
    "status": {
      "type": "string",
      "enum": [
        "IN_PROGRESS",
        "SUCCEEDED",
        "FAILED"
      ],
      "default": "IN_PROGRESS",
      "description": "Processing status"
    },
    "response_body": {
      "type": "object",
      "additionalProperties": true,
      "description": "Cached response"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Expiration timestamp"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this idempotency key"
    }
  },
  "required": [
    "tenant_id",
    "endpoint",
    "key",
    "request_hash",
    "expires_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.tenant_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.tenant_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Platform Admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.client_id}}"
            }
          ]
        }
      ]
    },
    "update": null,
    "delete": null
  }
}