{
  "name": "CriticalRoleRequirement",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Canonical tenant ID (sole partition key). Derived server-side."
    },
    "org_role_id": {
      "type": "string",
      "description": "OrgRole ID this requirement applies to"
    },
    "critical_role_id": {
      "type": "string",
      "description": "CriticalRole ID this requirement is for"
    },
    "requirement_text": {
      "type": "string",
      "description": "The requirement statement"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "rejected",
        "withdrawn"
      ],
      "default": "draft",
      "description": "Approval lifecycle status. Approved records are preserved unchanged on new blueprint approval \u2014 they are not reset to draft."
    },
    "applicability_status": {
      "type": "string",
      "enum": [
        "applicable",
        "stale_for_future_snapshots",
        "superseded"
      ],
      "default": "applicable",
      "description": "Applicability lifecycle. On new blueprint approval, previously approved requirements are marked stale_for_future_snapshots, not reset to draft."
    },
    "stale_since_blueprint_id": {
      "type": "string",
      "description": "Blueprint version that made this requirement stale"
    },
    "stale_marked_at": {
      "type": "string",
      "format": "date-time"
    },
    "stale_marked_by_operation_id": {
      "type": "string"
    },
    "revision_number": {
      "type": "number",
      "default": 1,
      "description": "Revision number. New revisions increment this. revises_requirement_id links to the prior revision."
    },
    "revises_requirement_id": {
      "type": "string",
      "description": "ID of the prior requirement revision this one replaces"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by_profile_id": {
      "type": "string"
    },
    "confidentiality_level": {
      "type": "string",
      "enum": [
        "standard",
        "confidential",
        "highly_confidential",
        "legally_restricted"
      ],
      "default": "confidential"
    },
    "integrity_status": {
      "type": "string",
      "enum": [
        "pending_validation",
        "active",
        "quarantined",
        "resolved"
      ],
      "default": "pending_validation"
    },
    "quarantine_reason": {
      "type": "string"
    },
    "quarantined_at": {
      "type": "string",
      "format": "date-time"
    },
    "quarantined_by_operation_id": {
      "type": "string"
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "exception_found"
      ],
      "default": "pending"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by_profile_id": {
      "type": "string"
    },
    "resolution_rationale": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "org_role_id",
    "requirement_text"
  ],
  "rls": {
    "create": false,
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.data.client_id}}"
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}