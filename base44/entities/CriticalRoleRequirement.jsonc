{
  "name": "CriticalRoleRequirement",
  "type": "object",
  "description": "Position-specific requirement belonging to a CriticalRole. May only represent: new position-specific requirement, position-specific modification of a canonical RoleRequirement, approved exception, or not-applicable determination. Must NOT replace RoleRequirement as the general blueprint requirement store. Every modification or exception must bind to an exact base_requirement_id, base_blueprint_id, and base_blueprint_version_number for source tracing.",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Canonical tenant ID (sole partition key). Derived server-side."
    },
    "org_role_id": {
      "type": "string",
      "description": "OrgRole ID this requirement's critical role applies to"
    },
    "critical_role_id": {
      "type": "string",
      "description": "CriticalRole ID this requirement belongs to. Required for position-specific requirements."
    },
    "modification_type": {
      "type": "string",
      "enum": [
        "new_requirement",
        "modification",
        "approved_exception",
        "not_applicable"
      ],
      "default": "new_requirement",
      "description": "new_requirement = position-specific addition. modification = alters a canonical RoleRequirement for this position. approved_exception = formal exception to a canonical requirement. not_applicable = determination that a canonical requirement does not apply."
    },
    "base_requirement_id": {
      "type": "string",
      "description": "The canonical RoleRequirement ID this modifies or excepts. Required for modification, approved_exception, and not_applicable. Null for new_requirement."
    },
    "base_blueprint_id": {
      "type": "string",
      "description": "The RoleSuccessBlueprint ID from which the base requirement was drawn. Required when base_requirement_id is set."
    },
    "base_blueprint_version_number": {
      "type": "number",
      "description": "The OrgRole.blueprint_approval_revision at which the base requirement was approved. Required when base_requirement_id is set."
    },
    "requirement_text": {
      "type": "string",
      "description": "The position-specific requirement statement, modification language, exception rationale, or not-applicable determination."
    },
    "requirement_detail": {
      "type": "string",
      "description": "Optional elaboration."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "rejected",
        "withdrawn"
      ],
      "default": "draft",
      "description": "Approval lifecycle. Approved records are preserved unchanged on new blueprint approval \u2014 they are marked stale_for_future_snapshots, not reset to draft."
    },
    "applicability_status": {
      "type": "string",
      "enum": [
        "applicable",
        "stale_for_future_snapshots",
        "superseded"
      ],
      "default": "applicable",
      "description": "Applicability lifecycle. On new blueprint approval, previously approved requirements are marked stale_for_future_snapshots."
    },
    "stale_since_blueprint_id": {
      "type": "string"
    },
    "stale_marked_at": {
      "type": "string",
      "format": "date-time"
    },
    "stale_marked_by_operation_id": {
      "type": "string"
    },
    "revision_number": {
      "type": "number",
      "default": 1,
      "description": "Revision number. New revisions increment this. revises_requirement_id links to the prior revision."
    },
    "revises_requirement_id": {
      "type": "string",
      "description": "ID of the prior requirement revision this one replaces"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_by_profile_id": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by_profile_id": {
      "type": "string"
    },
    "rejected_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejected_by_profile_id": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "withdrawn_at": {
      "type": "string",
      "format": "date-time"
    },
    "withdrawn_by_profile_id": {
      "type": "string"
    },
    "withdrawal_reason": {
      "type": "string"
    },
    "confidentiality_level": {
      "type": "string",
      "enum": [
        "standard",
        "confidential",
        "highly_confidential",
        "legally_restricted"
      ],
      "default": "confidential"
    },
    "integrity_status": {
      "type": "string",
      "enum": [
        "pending_validation",
        "active",
        "quarantined",
        "resolved"
      ],
      "default": "pending_validation"
    },
    "quarantine_reason": {
      "type": "string"
    },
    "quarantined_at": {
      "type": "string",
      "format": "date-time"
    },
    "quarantined_by_operation_id": {
      "type": "string"
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "exception_found"
      ],
      "default": "pending"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by_profile_id": {
      "type": "string"
    },
    "resolution_rationale": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "org_role_id",
    "modification_type",
    "requirement_text",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.client_id}}"
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}