{
  "name": "ProvisioningRole",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant ID"
    },
    "name": {
      "type": "string",
      "description": "Role name/slug (e.g., 'hr_admin')"
    },
    "display_name": {
      "type": "string",
      "description": "Human-readable role name"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Array of permission strings"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this provisioning role"
    }
  },
  "required": [
    "tenant_id",
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.tenant_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.tenant_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Platform Admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.client_id}}"
            }
          ]
        }
      ]
    },
    "update": null,
    "delete": null
  }
}