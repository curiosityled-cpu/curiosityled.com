{
  "name": "LearningResource",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Resource title"
    },
    "description": {
      "type": "string",
      "description": "Brief description of the resource"
    },
    "type": {
      "type": "string",
      "enum": [
        "book",
        "course",
        "article",
        "video",
        "whitepaper",
        "podcast",
        "assessment_tool",
        "document",
        "quiz",
        "external_link"
      ],
      "description": "Type of learning resource"
    },
    "provider": {
      "type": "string",
      "description": "Content provider (e.g., LinkedIn Learning, Harvard Business Review)"
    },
    "author": {
      "type": "string",
      "description": "Content author or creator"
    },
    "url": {
      "type": "string",
      "description": "URL to the resource"
    },
    "document_url": {
      "type": "string",
      "description": "URL to an uploaded document file"
    },
    "uploaded_file_uri": {
      "type": "string",
      "description": "Reference to the uploaded file: a private storage URI when storage_visibility is 'private', or a permanent public URL when it is 'public'"
    },
    "uploaded_file_name": {
      "type": "string",
      "description": "Original filename of the uploaded file"
    },
    "uploaded_file_type": {
      "type": "string",
      "description": "MIME type of the uploaded file (e.g. video/mp4, application/pdf)"
    },
    "uploaded_file_size": {
      "type": "number",
      "description": "Size of the uploaded file in bytes"
    },
    "media_kind": {
      "type": "string",
      "enum": [
        "video",
        "document"
      ],
      "description": "Whether the uploaded file is a video (played inline) or a document (opened or downloaded)"
    },
    "storage_visibility": {
      "type": "string",
      "enum": [
        "private",
        "public"
      ],
      "description": "How the uploaded file is stored. 'private' files are reachable only through short-lived signed URLs; 'public' files have a permanent open URL"
    },
    "embed_code": {
      "type": "string",
      "description": "HTML embed code for external content (e.g. videos, interactive tools)"
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Competencies this resource addresses"
    },
    "leadership_level": {
      "type": "string",
      "enum": [
        "Individual Contributor to First-Time Manager (entry-level leaders, frontline managers, new supervisors)",
        "Mid-Level Manager (managers of managers, experienced team leads, functional leads)",
        "Senior Manager / Business Unit Leader (leads larger teams, cross-functional groups, or business units)",
        "Director / Senior Director (enterprise-level strategic oversight, multiple functions, major initiatives)",
        "Executive / C-Suite (enterprise leadership, board-level strategy, organizational transformation)"
      ],
      "description": "Target leadership level for this resource"
    },
    "difficulty_level": {
      "type": "string",
      "enum": [
        "beginner",
        "intermediate",
        "advanced"
      ],
      "description": "Maps to Team Lead, Mid-Level, and Director levels"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for content categorization"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL to thumbnail image"
    },
    "cost_string": {
      "type": "string",
      "description": "The cost represented as a string (e.g., 'Free', '$15-25')"
    },
    "is_premium": {
      "type": "boolean",
      "default": false,
      "description": "True if the resource is not free"
    },
    "duration_string": {
      "type": "string",
      "description": "Estimated duration as a string"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this resource is currently available"
    },
    "year": {
      "type": "number",
      "description": "Publication or release year of the resource"
    },
    "access": {
      "type": "string",
      "enum": [
        "Free",
        "Subscription",
        "Purchase",
        "Program"
      ],
      "description": "How the resource is accessed"
    },
    "client_id": {
      "type": "string",
      "description": "Client that owns this resource (null for platform defaults)"
    },
    "prerequisite_resource_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of LearningResource IDs that must be completed before accessing this resource"
    },
    "prerequisite_conversational_learning_module_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of ConversationalLearningModule IDs that must be completed before accessing this resource"
    },
    "points_value": {
      "type": "number",
      "description": "Gamification points awarded for completing this resource (overrides default)"
    }
  },
  "required": [
    "title",
    "type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.is_active": true
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.client_id": "{{user.data.client_id}}"
        },
        {
          "user_condition": {
            "role": "Analyst"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 1"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Partner Business Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": null,
    "delete": null
  }
}