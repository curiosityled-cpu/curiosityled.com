{
  "name": "Tenant",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Organization or tenant name"
    },
    "status": {
      "type": "string",
      "enum": [
        "ACTIVE",
        "SUSPENDED"
      ],
      "default": "ACTIVE",
      "description": "Tenant status"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this tenant"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "Platform Admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": null,
    "delete": null
  }
}