{
  "name": "BrandingTheme",
  "type": "object",
  "properties": {
    "theme_name": {
      "type": "string",
      "description": "Name of the saved theme"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the client (tenant) that saved this theme. Null for themes that are part of the shared library every tenant can read."
    },
    "configuration": {
      "type": "object",
      "additionalProperties": true,
      "description": "Full branding configuration object"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this branding theme"
    }
  },
  "required": [
    "theme_name",
    "configuration"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "$or": [
                {
                  "data.client_id": null
                },
                {
                  "data.client_id": "{{user.data.client_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "$or": [
                {
                  "data.client_id": null
                },
                {
                  "data.client_id": "{{user.data.client_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "$or": [
                {
                  "data.client_id": null
                },
                {
                  "data.client_id": "{{user.data.client_id}}"
                }
              ]
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "$or": [
                {
                  "data.client_id": null
                },
                {
                  "data.client_id": "{{user.data.client_id}}"
                }
              ]
            }
          ]
        }
      ]
    }
  }
}