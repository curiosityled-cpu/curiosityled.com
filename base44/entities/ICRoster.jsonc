{
  "name": "ICRoster",
  "type": "object",
  "description": "Roster of non-user frontline individual contributors (ICs) who submit daily check-ins via Microsoft Teams or a token-gated web page. These staff are not registered app users and are never invited into the platform; their Teams identity or web access token is matched here so check-in submissions can be routed into DailyCheckIn. These employees typically also exist in the client's HRIS, LMS, and Microsoft tenant \u2014 hris_employee_id and source_system help reconcile the roster against those systems.",
  "properties": {
    "name": {
      "type": "string",
      "description": "Full name of the frontline staff member"
    },
    "email": {
      "type": "string",
      "description": "Email used as user_email on DailyCheckIn records. Should match the Teams account email/UPN for identity matching. Also used as the email notification destination."
    },
    "teams_user_id": {
      "type": "string",
      "description": "Azure AD object ID or UPN for the Teams account. Used as a fallback identity match if email differs."
    },
    "teams_conversation_id": {
      "type": "string",
      "description": "Teams conversation ID, captured automatically when the IC first messages the bot. Enables proactive check-in cards."
    },
    "client_id": {
      "type": "string",
      "description": "ID of the client (tenant) this IC belongs to"
    },
    "team": {
      "type": "string",
      "description": "Team, department, or shift label (e.g. 'Warehouse - Shift A')"
    },
    "manager_email": {
      "type": "string",
      "description": "Email of the IC's manager (an app user who can view this IC's check-in data and sees them in their team view)"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this IC is currently active and should receive check-in prompts"
    },
    "check_in_enabled": {
      "type": "boolean",
      "default": true,
      "description": "Whether this IC should receive daily check-in cards via Teams"
    },
    "preferred_channel": {
      "type": "string",
      "enum": [
        "teams",
        "email",
        "both"
      ],
      "default": "both",
      "description": "Where this IC receives check-in notifications. 'teams' = Adaptive Card only; 'email' = email with web link only; 'both' = Teams card plus email. ICs without a Teams conversation automatically fall back to email."
    },
    "web_access_token": {
      "type": "string",
      "description": "Unguessable token used to build the IC's private web check-in link (https://curiosityled.ai/ic-checkin?token=...). The link is not indexed and is only usable by whoever holds the token."
    },
    "hris_employee_id": {
      "type": "string",
      "description": "Employee ID in the client's HRIS. Used to reconcile this roster entry against the HRIS and avoid duplicates when the client uploads from multiple systems."
    },
    "source_system": {
      "type": "string",
      "enum": [
        "manual",
        "csv",
        "hris_sync",
        "teams_sync"
      ],
      "default": "manual",
      "description": "Where this roster record originated. 'manual' = added by hand; 'csv' = bulk uploaded; 'hris_sync' = imported from the client's HRIS; 'teams_sync' = auto-created when an unknown Teams user messaged the bot."
    },
    "last_check_in_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp of the most recent check-in submitted by this IC"
    },
    "created_by_email": {
      "type": "string",
      "description": "Email of the admin who added this IC to the roster"
    }
  },
  "required": [
    "name",
    "email",
    "client_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "Admin Level 1"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Partner Business Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.data.client_id}}"
        },
        {
          "data.manager_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.created_by_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "Admin Level 1"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Partner Business Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.created_by_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Partner Business Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    }
  }
}