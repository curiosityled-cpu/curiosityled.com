{
  "name": "Client",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Client organization name (e.g., 'Acme Corporation')"
    },
    "slug": {
      "type": "string",
      "description": "URL-safe identifier (e.g., 'acme-corp') - auto-generated if not provided"
    },
    "type": {
      "type": "string",
      "enum": [
        "direct_customer",
        "partner_client"
      ],
      "default": "direct_customer",
      "description": "Direct customer or managed by a partner"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "trial",
        "suspended",
        "cancelled"
      ],
      "default": "trial",
      "description": "Current subscription status"
    },
    "partner_id": {
      "type": "string",
      "description": "ID of the Partner managing this client (if applicable)"
    },
    "industry": {
      "type": "string",
      "description": "Industry sector"
    },
    "company_size": {
      "type": "string",
      "description": "Number of employees"
    },
    "contact_name": {
      "type": "string",
      "description": "Primary contact (CHRO, Director of L&D, etc.)"
    },
    "contact_email": {
      "type": "string",
      "description": "Primary contact email"
    },
    "contact_phone": {
      "type": "string",
      "description": "Primary contact phone"
    },
    "billing_email": {
      "type": "string",
      "description": "Email for invoices"
    },
    "contract_start_date": {
      "type": "string",
      "format": "date",
      "description": "Contract start date"
    },
    "contract_end_date": {
      "type": "string",
      "format": "date",
      "description": "Contract end date"
    },
    "license_count": {
      "type": "number",
      "description": "Number of user licenses purchased"
    },
    "seats_used": {
      "type": "number",
      "default": 0,
      "description": "Number of active users"
    },
    "annual_contract_value": {
      "type": "number",
      "description": "ACV in USD"
    },
    "payment_terms": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "annual",
        "one_time"
      ],
      "default": "annual",
      "description": "Payment frequency"
    },
    "stripe_customer_id": {
      "type": "string",
      "description": "Stripe customer ID for this client"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "Stripe subscription ID"
    },
    "selected_competency_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of Competency IDs selected by HR Admin/Super Admin as core competencies for this organization (3-5 competencies + Situational Intelligence)"
    },
    "competencies_configured": {
      "type": "boolean",
      "default": false,
      "description": "Whether the organization has configured their core competencies"
    },
    "settings": {
      "type": "object",
      "properties": {
        "allow_custom_competencies": {
          "type": "boolean",
          "default": true
        },
        "allow_custom_assessments": {
          "type": "boolean",
          "default": true
        },
        "allow_custom_learning": {
          "type": "boolean",
          "default": true
        },
        "include_leadership_index": {
          "type": "boolean",
          "default": true,
          "description": "Include default Leadership Index competencies"
        },
        "enable_industry_benchmarks": {
          "type": "boolean",
          "default": true,
          "description": "Show anonymized industry benchmarks"
        },
        "default_new_user_role": {
          "type": "string",
          "enum": [
            "User Level 1",
            "User Level 2",
            "Analyst"
          ],
          "default": "User Level 1",
          "description": "Default role for new users in this client"
        },
        "coaching_request_allowlist_enabled": {
          "type": "boolean",
          "default": false,
          "description": "When true, only users matching the allowlist can submit coaching_support requests for this client"
        },
        "coaching_request_allowed_roles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "App roles permitted to submit coaching requests (e.g. 'HRBP', 'User Level 2')"
        },
        "coaching_request_allowed_titles": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Job titles (current_role) permitted to submit coaching requests"
        },
        "coaching_request_allowed_emails": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Specific email addresses permitted to submit coaching requests"
        },
        "require_intake_conversation": {
          "type": "boolean",
          "default": true,
          "description": "When true, every coaching/consulting request requires an intake conversation before approval. Program Admins can still bypass per-request if intake_bypass_allowed is true."
        },
        "intake_bypass_allowed": {
          "type": "boolean",
          "default": true,
          "description": "Whether Program Admins are allowed to bypass the intake requirement on individual requests"
        },
        "check_in_config": {
          "type": "object",
          "properties": {
            "preset_id": {
              "type": "string",
              "enum": [
                "balance",
                "wellbeing",
                "performance"
              ],
              "default": "balance",
              "description": "Which check-in preset is active for this organization"
            },
            "question_style": {
              "type": "string",
              "enum": [
                "likert_statement",
                "conversational"
              ],
              "default": "likert_statement",
              "description": "How check-in questions are phrased"
            },
            "proactivity_level": {
              "type": "string",
              "enum": [
                "reactive",
                "suggestive",
                "proactive"
              ],
              "default": "proactive",
              "description": "How proactive Atreus is with check-ins for this org"
            },
            "default_cadence": {
              "type": "string",
              "enum": [
                "daily",
                "every_other_day",
                "important_only",
                "paused"
              ],
              "default": "daily",
              "description": "Default check-in cadence for new users in this org"
            },
            "weekly_reflection_day": {
              "type": "string",
              "enum": [
                "monday",
                "tuesday",
                "wednesday",
                "thursday",
                "friday",
                "saturday",
                "sunday"
              ],
              "default": "friday",
              "description": "Default day for the weekly rhythm reflection"
            },
            "dnd_windows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "days": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "start": {
                    "type": "string"
                  },
                  "end": {
                    "type": "string"
                  }
                }
              },
              "default": [],
              "description": "Default Do-Not-Disturb windows applied to new users"
            }
          },
          "description": "Check-in engine configuration for this organization"
        },
        "ui_density_default": {
          "type": "string",
          "enum": [
            "compact",
            "detailed"
          ],
          "default": "compact",
          "description": "Default UI density for managers in this organization"
        },
        "goals": {
          "type": "object",
          "properties": {
            "framework": {
              "type": "string",
              "enum": [
                "goals",
                "kpis",
                "okrs",
                "hybrid"
              ],
              "default": "goals",
              "description": "Goal framework this organization uses"
            },
            "cascade_enabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether goals cascade from org to team to individual"
            },
            "review_cadence": {
              "type": "string",
              "enum": [
                "weekly",
                "biweekly",
                "monthly",
                "quarterly"
              ],
              "default": "monthly",
              "description": "Default goal review cadence"
            },
            "require_manager_approval": {
              "type": "boolean",
              "default": false,
              "description": "Whether manager approval is required to commit a goal"
            }
          },
          "description": "Performance & goal framework configuration"
        },
        "assessment": {
          "type": "object",
          "properties": {
            "require_baseline": {
              "type": "boolean",
              "default": true,
              "description": "Whether a baseline assessment is required at onboarding"
            },
            "reassessment_cadence_months": {
              "type": "number",
              "default": 6,
              "description": "How often reassessments run (months)"
            },
            "enable_360": {
              "type": "boolean",
              "default": false,
              "description": "Whether 360-degree feedback is enabled"
            },
            "scoring_scale": {
              "type": "number",
              "enum": [
                5,
                7
              ],
              "default": 5,
              "description": "Assessment scoring scale (1-5 or 1-7)"
            }
          },
          "description": "Assessment cadence and scope configuration"
        },
        "coaching": {
          "type": "object",
          "properties": {
            "enabled_engagement_types": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "1on1_coaching",
                  "team_effectiveness",
                  "leadership_development",
                  "career_coaching",
                  "performance_improvement",
                  "executive_coaching"
                ]
              },
              "default": [
                "1on1_coaching",
                "leadership_development"
              ],
              "description": "Which coaching engagement types are offered"
            },
            "default_session_count": {
              "type": "number",
              "default": 6,
              "description": "Default number of sessions per engagement"
            },
            "default_session_length_minutes": {
              "type": "number",
              "default": 60,
              "description": "Default session length in minutes"
            },
            "allow_external_coaches": {
              "type": "boolean",
              "default": true,
              "description": "Whether external coaches are permitted (vs internal only)"
            }
          },
          "description": "Coaching engagement defaults"
        },
        "notifications": {
          "type": "object",
          "properties": {
            "enabled_channels": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "in_app",
                  "email",
                  "teams",
                  "slack",
                  "push"
                ]
              },
              "default": [
                "in_app",
                "email"
              ],
              "description": "Notification channels available org-wide"
            },
            "default_cadence": {
              "type": "string",
              "enum": [
                "instant",
                "daily",
                "weekly"
              ],
              "default": "instant",
              "description": "Default notification cadence for new users"
            }
          },
          "description": "Notification channel and cadence defaults"
        },
        "integrations": {
          "type": "object",
          "properties": {
            "enabled_providers": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "googlecalendar",
                  "outlook",
                  "hubspot"
                ]
              },
              "default": [],
              "description": "External providers enabled for pattern detection and insights"
            }
          },
          "description": "Integration scope configuration"
        },
        "privacy": {
          "type": "object",
          "properties": {
            "default_confidentiality_level": {
              "type": "string",
              "enum": [
                "standard",
                "confidential",
                "highly_confidential"
              ],
              "default": "confidential",
              "description": "Default confidentiality level for coaching engagements"
            },
            "hr_visibility_mode": {
              "type": "string",
              "enum": [
                "individual",
                "aggregates_only"
              ],
              "default": "aggregates_only",
              "description": "Whether HR sees individual check-in data or only aggregates"
            },
            "data_retention_days": {
              "type": "number",
              "default": 90,
              "description": "How long to retain activity data (days)"
            }
          },
          "description": "Privacy and visibility defaults"
        },
        "gamification": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true,
              "description": "Whether points, levels, and leaderboards are enabled org-wide"
            },
            "leaderboard_scope": {
              "type": "string",
              "enum": [
                "org_wide",
                "team_scoped",
                "disabled"
              ],
              "default": "team_scoped",
              "description": "Leaderboard visibility scope"
            }
          },
          "description": "Gamification configuration"
        },
        "reporting": {
          "type": "object",
          "properties": {
            "default_landing_view": {
              "type": "string",
              "enum": [
                "org",
                "team",
                "personal"
              ],
              "default": "org",
              "description": "Default analytics landing view for this org"
            },
            "enabled_export_formats": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "pdf",
                  "csv",
                  "xlsx"
                ]
              },
              "default": [
                "pdf",
                "csv"
              ],
              "description": "Export formats enabled for reports"
            }
          },
          "description": "Reporting defaults"
        },
        "locks": {
          "type": "object",
          "description": "Org-override locks. When a key is true, the corresponding personal setting is locked to the org value for non-super-admin users.",
          "additionalProperties": {
            "type": "boolean"
          },
          "default": {}
        }
      },
      "description": "Feature flags and settings"
    },
    "branding_config_id": {
      "type": "string",
      "description": "ID of the BrandingConfiguration for this client"
    },
    "custom_domain": {
      "type": "string",
      "description": "Custom domain (e.g., 'leadership.acme.com')"
    },
    "onboarding_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started",
      "description": "Client onboarding status"
    },
    "onboarding_completed_date": {
      "type": "string",
      "format": "date-time",
      "description": "When client onboarding was completed"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this client"
    }
  },
  "required": [
    "name",
    "contact_email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "Platform Admin"
      }
    },
    "read": {
      "$or": [
        {
          "id": "{{user.data.client_id}}"
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "user_condition": {
            "role": "Platform Administrator"
          }
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        }
      ]
    },
    "update": null,
    "delete": null
  }
}