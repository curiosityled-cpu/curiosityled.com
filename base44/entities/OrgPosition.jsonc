{
  "name": "OrgPosition",
  "type": "object",
  "description": "A specific position in the organizational structure, instantiating an OrgRole. Includes reports_to_position_id for hierarchy. Position changes are recorded as immutable OrgPositionChange records, not by mutating the position.",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Canonical tenant ID (sole partition key). Derived server-side."
    },
    "org_role_id": {
      "type": "string",
      "description": "OrgRole ID this position instantiates"
    },
    "title": {
      "type": "string",
      "description": "Position title"
    },
    "position_identifier": {
      "type": "string",
      "description": "Position code or system identifier. Uniqueness-checked within tenant."
    },
    "reports_to_position_id": {
      "type": "string",
      "description": "OrgPosition ID this position reports to. Null for top-level positions. Must belong to the same tenant."
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this position is currently active in the org. Deactivation is recorded via OrgPositionChange."
    },
    "replaced_by_position_id": {
      "type": "string",
      "description": "If this position was replaced, the ID of the replacement position. Set by successionReplaceOrgPosition."
    },
    "confidentiality_level": {
      "type": "string",
      "enum": [
        "standard",
        "confidential",
        "highly_confidential",
        "legally_restricted"
      ],
      "default": "confidential"
    },
    "integrity_status": {
      "type": "string",
      "enum": [
        "pending_validation",
        "active",
        "quarantined",
        "resolved"
      ],
      "default": "pending_validation"
    },
    "quarantine_reason": {
      "type": "string"
    },
    "quarantined_at": {
      "type": "string",
      "format": "date-time"
    },
    "quarantined_by_operation_id": {
      "type": "string"
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "exception_found"
      ],
      "default": "pending"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by_profile_id": {
      "type": "string"
    },
    "resolution_rationale": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "org_role_id",
    "title"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__succession_control_plane_only__"
      }
    },
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.data.client_id}}"
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__succession_control_plane_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__succession_control_plane_only__"
      }
    }
  }
}