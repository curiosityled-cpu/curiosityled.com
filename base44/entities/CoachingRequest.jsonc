{
  "name": "CoachingRequest",
  "type": "object",
  "properties": {
    "request_category": {
      "type": "string",
      "enum": [
        "1on1_coaching",
        "group_coaching",
        "team_coaching",
        "workshop",
        "consultation",
        "assessment"
      ],
      "description": "Category of the request \u2014 determines Coach vs Consultant routing"
    },
    "participant_scope": {
      "type": "string",
      "enum": [
        "individual",
        "cohort",
        "team"
      ],
      "default": "individual",
      "description": "Who the request is for \u2014 a single person, a cohort, or a team"
    },
    "participant_identifier": {
      "type": "string",
      "description": "Email (individual), cohort ID, or team identifier"
    },
    "participant_name": {
      "type": "string",
      "description": "Display name of the participant(s)"
    },
    "requested_by_email": {
      "type": "string",
      "description": "Email of the person who submitted the request"
    },
    "requested_by_name": {
      "type": "string",
      "description": "Display name of the requestor"
    },
    "client_id": {
      "type": "string",
      "description": "Client organization ID"
    },
    "title": {
      "type": "string",
      "description": "Short title for the request"
    },
    "description": {
      "type": "string",
      "description": "What the requestor is asking for \u2014 context, goals, situation"
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "intake_scheduled",
        "intake_complete",
        "approved",
        "assigned",
        "accepted",
        "declined",
        "engagement_created",
        "in_progress",
        "completed",
        "rejected"
      ],
      "default": "submitted",
      "description": "Current stage of the request lifecycle"
    },
    "designated_program_admin_email": {
      "type": "string",
      "description": "Email of the Program Administrator responsible for triaging this request"
    },
    "assigned_practitioner_email": {
      "type": "string",
      "description": "Email of the Coach or Consultant assigned to this request"
    },
    "assigned_practitioner_role": {
      "type": "string",
      "enum": [
        "Leadership Coach",
        "Consultant"
      ],
      "description": "Role of the assigned practitioner (derived from request_category)"
    },
    "decline_reason": {
      "type": "string",
      "description": "Reason given by the practitioner when declining (loops back to assigned)"
    },
    "linked_engagement_id": {
      "type": "string",
      "description": "ID of the CoachingEngagement created when the request was accepted"
    },
    "intake_conversation_required": {
      "type": "boolean",
      "default": true,
      "description": "Whether an intake conversation is required before approval (defaulted from Client settings)"
    },
    "intake_bypassed": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Program Admin bypassed the intake conversation for this request"
    },
    "intake_notes": {
      "type": "string",
      "description": "Notes captured during the intake conversation"
    },
    "intake_scheduled_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the intake conversation is scheduled for"
    },
    "competency_focus": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Competency IDs this request focuses on"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "standard",
        "priority",
        "urgent"
      ],
      "default": "standard",
      "description": "Priority level of the request"
    },
    "requested_start_date": {
      "type": "string",
      "format": "date",
      "description": "When the requestor would like the engagement to begin"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes from the requestor or admin"
    }
  },
  "required": [
    "request_category",
    "requested_by_email",
    "client_id",
    "title"
  ],
  "rls": {
    "create": true,
    "read": {
      "$or": [
        {
          "data.requested_by_email": "{{user.email}}"
        },
        {
          "data.designated_program_admin_email": "{{user.email}}"
        },
        {
          "data.assigned_practitioner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "HRBP"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.requested_by_email": "{{user.email}}"
        },
        {
          "data.designated_program_admin_email": "{{user.email}}"
        },
        {
          "data.assigned_practitioner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.client_id": "{{user.client_id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        }
      ]
    }
  }
}