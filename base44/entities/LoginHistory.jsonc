{
  "name": "LoginHistory",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who attempted login"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the client (tenant) the account belongs to, stamped when the attempt is recorded so sign-in history stays tenant-scoped"
    },
    "login_timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the login attempt occurred"
    },
    "ip_address": {
      "type": "string",
      "description": "IP address of the login attempt"
    },
    "device_type": {
      "type": "string",
      "description": "Device type (desktop, mobile, tablet)"
    },
    "browser": {
      "type": "string",
      "description": "Browser used for login"
    },
    "location": {
      "type": "string",
      "description": "Geographic location (city, country)"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "failed",
        "locked"
      ],
      "description": "Login attempt status"
    },
    "failure_reason": {
      "type": "string",
      "description": "Reason for failed login (wrong password, account locked, etc.)"
    },
    "session_id": {
      "type": "string",
      "description": "Unique session identifier for successful logins"
    },
    "session_ended_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the session ended (logout or expiry)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this login attempt"
    }
  },
  "required": [
    "user_email",
    "login_timestamp",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "Platform Admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": null,
    "delete": null
  }
}