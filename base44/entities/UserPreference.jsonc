{
  "name": "UserPreference",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user"
    },
    "atreus_preferences": {
      "type": "object",
      "description": "Preferences related to Atreus AI interaction",
      "properties": {
        "communication_style": {
          "type": "string",
          "enum": [
            "concise",
            "detailed",
            "balanced"
          ],
          "default": "balanced",
          "description": "Preferred response style from Atreus"
        },
        "preferred_action_types": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Types of actions user frequently uses"
        },
        "common_tasks_history": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Recently executed tasks via Atreus"
        },
        "interaction_frequency": {
          "type": "string",
          "enum": [
            "high",
            "medium",
            "low"
          ],
          "default": "medium",
          "description": "How often user interacts with Atreus"
        },
        "feedback_history": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "timestamp": {
                "type": "string"
              },
              "rating": {
                "type": "number"
              },
              "comment": {
                "type": "string"
              }
            }
          },
          "description": "User feedback on Atreus responses"
        }
      }
    },
    "notification_preferences": {
      "type": "object",
      "additionalProperties": true,
      "description": "User notification preferences"
    },
    "privacy_settings": {
      "type": "object",
      "properties": {
        "allow_activity_tracking": {
          "type": "boolean",
          "default": true,
          "description": "Allow Atreus to track activity for personalization"
        },
        "allow_proactive_suggestions": {
          "type": "boolean",
          "default": true,
          "description": "Allow Atreus to provide proactive insights"
        },
        "data_retention_days": {
          "type": "number",
          "default": 90,
          "description": "How long to retain activity data (days)"
        }
      },
      "description": "Privacy and data retention preferences"
    },
    "ui_density": {
      "type": "string",
      "enum": [
        "compact",
        "detailed"
      ],
      "description": "User's preferred UI density (overrides org default). compact = headline + collapsed detail; detailed = full cards expanded."
    },
    "check_in_preset_override": {
      "type": "string",
      "enum": [
        "balance",
        "wellbeing",
        "performance"
      ],
      "description": "User's personal check-in preset override (overrides org default)"
    },
    "workout_preferences": {
      "type": "object",
      "description": "Preferences controlling the pattern-driven workout engine on the Practice page",
      "properties": {
        "refresh_frequency": {
          "type": "string",
          "enum": [
            "nightly",
            "twice_weekly",
            "weekly",
            "manual"
          ],
          "default": "nightly",
          "description": "How often new workouts are generated from active patterns"
        },
        "max_active_workouts": {
          "type": "number",
          "minimum": 1,
          "maximum": 5,
          "default": 3,
          "description": "Maximum number of unstarted workouts kept active at once"
        },
        "unstarted_expiry_days": {
          "type": "number",
          "enum": [
            3,
            7,
            14
          ],
          "default": 7,
          "description": "Days before an unstarted workout is auto-expired"
        },
        "preferred_workout_type": {
          "type": "string",
          "enum": [
            "skill",
            "task",
            "both"
          ],
          "default": "both",
          "description": "Whether to prioritize skill-building workouts, task-based workouts, or both"
        }
      }
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of these user preferences"
    }
  },
  "required": [
    "user_email"
  ],
  "rls": {
    "create": {
      "data.user_email": "{{user.email}}"
    },
    "read": {
      "user_email": "{{user.email}}"
    },
    "update": null,
    "delete": null
  }
}