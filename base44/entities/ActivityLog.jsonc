{
  "name": "ActivityLog",
  "type": "object",
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "When the action occurred"
    },
    "initiator_user_email": {
      "type": "string",
      "description": "Email of the user who performed the action"
    },
    "action_type": {
      "type": "string",
      "enum": [
        "USER_ROLE_CHANGE",
        "USER_CREATED",
        "USER_DELETED",
        "USER_ACCOUNT_SUSPENDED",
        "USER_ACCOUNT_ACTIVATED",
        "USER_ACCOUNT_LOCKED",
        "USER_ACCOUNT_UNLOCKED",
        "USER_INVITATION_RESENT",
        "USER_SESSIONS_TERMINATED",
        "GOAL_BULK_ASSIGNED",
        "GOAL_CASCADE",
        "USERS_BULK_CREATED",
        "ONBOARDING_PLAN_DEPLOYED",
        "REQUEST_CREATED",
        "REQUEST_ASSIGNED",
        "REQUEST_APPROVED",
        "REQUEST_REJECTED",
        "PROVISIONING_BATCH_CREATED",
        "PROVISIONING_BATCH_APPLIED",
        "PROVISIONING_INVITES_SENT",
        "PROVISIONING_USER_LINKED",
        "PROVISIONING_NONCE_CLEANUP",
        "PROVISIONING_EXTERNAL_REQUEST_REJECTED"
      ],
      "description": "Type of action performed"
    },
    "target_user_email": {
      "type": "string",
      "description": "Email of the user affected by this action (if applicable)"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the client this activity belongs to"
    },
    "old_value": {
      "type": "string",
      "description": "Previous value before the change"
    },
    "new_value": {
      "type": "string",
      "description": "New value after the change"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Additional context about the action"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this activity"
    }
  },
  "required": [
    "timestamp",
    "initiator_user_email",
    "action_type",
    "client_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.initiator_user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "Admin Level 1"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Analyst"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "data.initiator_user_email": "{{user.email}}",
          "data.client_id": "{{user.data.client_id}}"
        },
        {
          "data.target_user_email": "{{user.email}}",
          "data.client_id": "{{user.data.client_id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "User Level 2"
              }
            },
            {
              "data.target_user_email": {
                "$in": "{{user.data.subordinate_emails}}"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        }
      ]
    },
    "update": null,
    "delete": null
  }
}