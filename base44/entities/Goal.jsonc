{
  "name": "Goal",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Goal title"
    },
    "description": {
      "type": "string",
      "description": "Goal description"
    },
    "goal_type": {
      "type": "string",
      "enum": [
        "standard",
        "okr_objective",
        "coaching_goal",
        "action_item",
        "behavioral_commitment"
      ],
      "default": "standard",
      "description": "Type of goal: standard goal, OKR objective, coaching goal, action item, or behavioral commitment (a specific leadership behavior the manager committed to changing)"
    },
    "timeframe_start": {
      "type": "string",
      "format": "date",
      "description": "Start date for the goal (especially important for OKRs)"
    },
    "timeframe_end": {
      "type": "string",
      "format": "date",
      "description": "End date for the goal (especially important for OKRs)"
    },
    "linked_competency_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of Competency IDs linked to this goal"
    },
    "color": {
      "type": "string",
      "default": "#0073EA",
      "description": "Goal accent color"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "private",
        "shared"
      ],
      "default": "private",
      "description": "Goal visibility setting"
    },
    "view_type": {
      "type": "string",
      "enum": [
        "table",
        "kanban",
        "calendar"
      ],
      "default": "table",
      "description": "Current view type"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "archived"
      ],
      "default": "active",
      "description": "Goal status"
    },
    "progress": {
      "type": "number",
      "default": 0,
      "description": "Progress percentage (0-100), especially for OKRs"
    },
    "client_id": {
      "type": "string",
      "description": "Client ID for multi-tenant support"
    },
    "department": {
      "type": "string",
      "description": "Department or business unit this goal belongs to"
    },
    "program_id": {
      "type": "string",
      "description": "Program ID if this is a program-related goal"
    },
    "coach_email": {
      "type": "string",
      "description": "Email of the coach who created/manages this goal (for coaching goals)"
    },
    "coaching_session_id": {
      "type": "string",
      "description": "ID of the CoachingSession this goal originated from"
    },
    "coaching_engagement_id": {
      "type": "string",
      "description": "ID of the CoachingEngagement this goal is part of"
    },
    "assigned_to_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of user emails this goal is assigned to (for managers assigning to direct reports)"
    },
    "cascaded_from_goal_id": {
      "type": "string",
      "description": "ID of the parent goal this was cascaded from. Used to build parent-child goal trees and auto-rollup progress."
    },
    "members": {
      "type": "array",
      "description": "Team members with role-based access",
      "items": {
        "type": "object",
        "properties": {
          "user_email": {
            "type": "string"
          },
          "user_name": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "owner",
              "editor",
              "viewer"
            ]
          },
          "added_date": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "columns": {
      "type": "array",
      "description": "Global goal column definitions (can be overridden per group)",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "status",
              "date",
              "people",
              "number",
              "budget",
              "priority",
              "checkbox",
              "dropdown"
            ]
          },
          "width": {
            "type": "number",
            "default": 150
          },
          "options": {
            "type": "object",
            "description": "Column-specific options"
          }
        }
      }
    },
    "groups": {
      "type": "array",
      "description": "Goal groups/sections",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "collapsed": {
            "type": "boolean",
            "default": false
          },
          "visible_columns": {
            "type": "array",
            "description": "Column IDs that are visible in this group",
            "items": {
              "type": "string"
            }
          },
          "custom_columns": {
            "type": "array",
            "description": "Custom columns specific to this group",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "text",
                    "status",
                    "date",
                    "people",
                    "number",
                    "budget",
                    "priority",
                    "checkbox",
                    "dropdown"
                  ]
                },
                "width": {
                  "type": "number",
                  "default": 150
                },
                "options": {
                  "type": "object",
                  "description": "Column-specific options"
                }
              }
            }
          }
        }
      }
    },
    "points_value": {
      "type": "number",
      "description": "Number of gamification points awarded for completing this goal (overrides default)"
    },
    "evidence_entries": {
      "type": "array",
      "description": "Performance evidence entries attached to this goal. Supports the 'defensible' layer of performance management. note_type='behavior_demonstration' is a deliberate, specificity-gated self-confirmation of a committed behavior (requires situation description + date).",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique entry ID"
          },
          "note_type": {
            "type": "string",
            "enum": [
              "accomplishment",
              "feedback",
              "context",
              "concern",
              "behavior_demonstration"
            ],
            "description": "Type of evidence entry. behavior_demonstration = deliberate self-confirmation that a committed behavior was demonstrated in a specific situation."
          },
          "description": {
            "type": "string",
            "description": "Evidence description / narrative. For behavior_demonstration, this is the situation description (mandatory, min 10 chars)."
          },
          "source": {
            "type": "string",
            "enum": [
              "manual",
              "checkin",
              "coaching_session",
              "hris_import",
              "api_sync",
              "sftp_sync"
            ],
            "default": "manual",
            "description": "Where this evidence entry originated"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Date the evidence event occurred or was observed"
          },
          "added_by_email": {
            "type": "string",
            "description": "Email of the user who added this entry"
          },
          "visibility": {
            "type": "string",
            "enum": [
              "private_reflection",
              "employee_and_manager",
              "hr_only",
              "formal_record"
            ],
            "default": "employee_and_manager",
            "description": "Who can see this evidence entry"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Optional tags for categorization"
          },
          "linked_kpi_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "KPI IDs this evidence relates to"
          },
          "added_at": {
            "type": "string",
            "format": "date-time",
            "description": "When this entry was added"
          }
        },
        "required": [
          "id",
          "note_type",
          "description",
          "date"
        ]
      }
    },
    "review_cycle_id": {
      "type": "string",
      "description": "ID of the review cycle (CustomForm with form_type='review_cycle') this goal is linked to"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.visibility": "shared"
        },
        {
          "created_by": "{{user.email}}"
        },
        {
          "data.assigned_to_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "data.members": {
            "$elemMatch": {
              "user_email": "{{user.email}}"
            }
          }
        },
        {
          "data.coach_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Analyst"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "User Level 2"
              }
            },
            {
              "created_by": {
                "$in": "{{user.data.subordinate_emails}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.program_id": {
                "$in": "{{user.data.managed_program_ids}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.coaching_engagement_id": {
                "$exists": true
              }
            },
            {
              "data.coach_email": "{{user.email}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": null,
    "delete": null
  }
}