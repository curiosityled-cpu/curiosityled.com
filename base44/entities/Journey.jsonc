{
  "name": "Journey",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "catalog",
        "assigned"
      ],
      "description": "Legacy migration flag. New records leave this unset \u2014 the unified model uses in_content_library + assigned_to_emails instead."
    },
    "title": {
      "type": "string",
      "description": "Name of the journey"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the journey"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL to journey thumbnail/cover image"
    },
    "author_email": {
      "type": "string",
      "description": "Email of the user who created this journey"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the client this journey belongs to"
    },
    "partner_id": {
      "type": "string",
      "description": "ID of the partner this journey belongs to"
    },
    "in_content_library": {
      "type": "boolean",
      "default": false,
      "description": "Whether this journey is saved in the reusable content library (program admins and above only). Library items can be assigned to many learners."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived",
        "active",
        "paused",
        "completed",
        "cancelled"
      ],
      "default": "active",
      "description": "Lifecycle status of the journey"
    },
    "type": {
      "type": "string",
      "enum": [
        "curriculum",
        "learning_path"
      ],
      "description": "Library items: curriculum = learners complete in any order, learning_path = specific sequence required"
    },
    "template_category": {
      "type": "string",
      "enum": [
        "technical",
        "leadership",
        "sales",
        "operations",
        "compliance",
        "onboarding",
        "general",
        "custom"
      ],
      "description": "Category for organization in the content library"
    },
    "template_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for filtering and searching in the library"
    },
    "use_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this library item has been assigned"
    },
    "last_used_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this library item was last assigned"
    },
    "content_structure": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "learning_resource_id": {
            "type": "string",
            "description": "ID of the learning resource"
          },
          "order": {
            "type": "number",
            "description": "Order in the sequence (for learning paths)"
          },
          "is_optional": {
            "type": "boolean",
            "default": false
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "unlock_condition": {
            "type": "string",
            "enum": [
              "immediate",
              "time_based",
              "score_based",
              "sequential"
            ],
            "default": "immediate"
          },
          "unlock_after_days": {
            "type": "number",
            "default": 0
          },
          "required_score_percentage": {
            "type": "number",
            "default": 0
          }
        },
        "required": [
          "learning_resource_id"
        ]
      },
      "description": "Ordered list of learning resources with gating options (library items)"
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "provider_or_sponsor": {
            "type": "string"
          },
          "start_date": {
            "type": "string"
          },
          "end_date": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "default": "planned"
          },
          "expected_impact": {
            "type": "number"
          }
        }
      },
      "description": "Off-platform development experiences included in this journey"
    },
    "learning_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "default": "not_started"
          }
        }
      },
      "description": "Learning resources included in this journey"
    },
    "signal_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "signal_id": {
            "type": "string",
            "description": "ID of the signal (CustomAssessment or CustomForm)"
          },
          "entity_type": {
            "type": "string",
            "enum": [
              "CustomAssessment",
              "CustomForm"
            ],
            "description": "Which entity the signal lives in"
          },
          "signal_type": {
            "type": "string",
            "description": "Signal type label (assessment, quiz, survey, pulse, feedback, custom)"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "default": "not_started"
          }
        },
        "required": [
          "signal_id",
          "entity_type"
        ]
      },
      "description": "Signals (assessments, quizzes, surveys, pulses, feedback) included in this journey"
    },
    "target_competencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Competencies this journey targets"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "Target completion date"
    },
    "estimated_duration_days": {
      "type": "number",
      "description": "Estimated number of days to complete (library items)"
    },
    "target_audiences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Target audiences (library items)"
    },
    "assigned_to_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of users assigned to this journey"
    },
    "assigned_to_cohort_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of cohorts assigned to this journey"
    },
    "shared_admin_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of other users who can manage this journey"
    },
    "last_modified_by": {
      "type": "string",
      "description": "Email of the last person to modify this journey"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorization and search"
    },
    "completion_criteria": {
      "type": "object",
      "properties": {
        "completion_percentage_required": {
          "type": "number",
          "default": 100
        },
        "require_all_mandatory": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Criteria for journey completion"
    },
    "points_value": {
      "type": "number",
      "description": "Number of gamification points awarded for completing this journey"
    },
    "completion_badge_id": {
      "type": "string",
      "description": "ID of the BadgeTemplate awarded upon journey completion"
    },
    "source_entity": {
      "type": "string",
      "enum": [
        "LearningJourney",
        "DevelopmentPlan"
      ],
      "description": "Original entity this record was migrated from (migration tracking)"
    },
    "source_id": {
      "type": "string",
      "description": "Original record ID this was migrated from (migration tracking, enables idempotent re-runs)"
    }
  },
  "required": [
    "title"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "Admin Level 1"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "data.assigned_to_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "data.shared_admin_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "data.in_content_library": true
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Analyst"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": null,
    "delete": null
  }
}