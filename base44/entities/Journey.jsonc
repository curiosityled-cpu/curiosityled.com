{
  "name": "Journey",
  "type": "object",
  "properties": {
    "mode": {
      "type": "string",
      "enum": [
        "catalog",
        "assigned"
      ],
      "description": "catalog = reusable authored learning asset (published, templated, assigned to many). assigned = person-specific development plan tied to one user_email."
    },
    "title": {
      "type": "string",
      "description": "Name of the journey"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the journey"
    },
    "thumbnail_url": {
      "type": "string",
      "description": "URL to journey thumbnail/cover image"
    },
    "author_email": {
      "type": "string",
      "description": "Email of the user who created this journey (catalog mode)"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the person this journey is assigned to (assigned mode)"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the client this journey belongs to"
    },
    "partner_id": {
      "type": "string",
      "description": "ID of the partner this journey belongs to"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "published",
        "archived",
        "template",
        "active",
        "paused",
        "completed",
        "cancelled"
      ],
      "default": "draft",
      "description": "Lifecycle status. catalog mode uses draft/published/archived/template. assigned mode uses active/paused/completed/cancelled."
    },
    "type": {
      "type": "string",
      "enum": [
        "curriculum",
        "learning_path"
      ],
      "description": "catalog mode only: curriculum = learners complete in any order, learning_path = specific sequence required"
    },
    "is_template": {
      "type": "boolean",
      "default": false,
      "description": "Whether this journey is a template for reuse (catalog mode)"
    },
    "template_category": {
      "type": "string",
      "enum": [
        "technical",
        "leadership",
        "sales",
        "operations",
        "compliance",
        "onboarding",
        "general",
        "custom"
      ],
      "description": "Category of the template for organization (catalog mode)"
    },
    "template_tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for filtering and searching templates (catalog mode)"
    },
    "use_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this template has been used"
    },
    "last_used_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this template was last used"
    },
    "content_structure": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "learning_resource_id": {
            "type": "string",
            "description": "ID of the learning resource"
          },
          "order": {
            "type": "number",
            "description": "Order in the sequence (for learning paths)"
          },
          "is_optional": {
            "type": "boolean",
            "default": false,
            "description": "Whether this resource is optional"
          },
          "title": {
            "type": "string",
            "description": "Cached title of the resource"
          },
          "type": {
            "type": "string",
            "description": "Cached type of the resource"
          },
          "unlock_condition": {
            "type": "string",
            "enum": [
              "immediate",
              "time_based",
              "score_based",
              "sequential"
            ],
            "default": "immediate",
            "description": "How this resource unlocks for learners"
          },
          "unlock_after_days": {
            "type": "number",
            "default": 0,
            "description": "Days to wait before unlocking (for time_based)"
          },
          "required_score_percentage": {
            "type": "number",
            "default": 0,
            "description": "Score required on previous item (for score_based)"
          }
        },
        "required": [
          "learning_resource_id"
        ]
      },
      "description": "Ordered list of learning resources in this journey with gating options (catalog mode)"
    },
    "experiences": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "provider_or_sponsor": {
            "type": "string"
          },
          "start_date": {
            "type": "string"
          },
          "end_date": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "default": "planned"
          },
          "expected_impact": {
            "type": "number"
          }
        }
      },
      "description": "Off-platform development experiences included in this journey (assigned mode)"
    },
    "learning_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "resource_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "provider": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "default": "not_started"
          }
        }
      },
      "description": "Learning resources included in this journey (assigned mode)"
    },
    "target_competencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Competencies this journey targets (assigned mode)"
    },
    "target_date": {
      "type": "string",
      "format": "date",
      "description": "Target completion date (assigned mode)"
    },
    "estimated_duration_days": {
      "type": "number",
      "description": "Estimated number of days to complete (catalog mode)"
    },
    "target_audiences": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Target audiences for this journey (catalog mode)"
    },
    "assigned_to_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of users directly assigned to this journey (catalog mode)"
    },
    "assigned_to_cohort_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs of cohorts assigned to this journey (catalog mode)"
    },
    "shared_admin_emails": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Emails of other users who can manage this journey"
    },
    "last_modified_by": {
      "type": "string",
      "description": "Email of the last person to modify this journey"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tags for categorization and search"
    },
    "completion_criteria": {
      "type": "object",
      "properties": {
        "completion_percentage_required": {
          "type": "number",
          "default": 100,
          "description": "Percentage of content that must be completed"
        },
        "require_all_mandatory": {
          "type": "boolean",
          "default": true,
          "description": "Whether all non-optional resources must be completed"
        }
      },
      "description": "Criteria for journey completion"
    },
    "points_value": {
      "type": "number",
      "description": "Number of gamification points awarded for completing this journey"
    },
    "completion_badge_id": {
      "type": "string",
      "description": "ID of the BadgeTemplate awarded upon journey completion"
    },
    "source_entity": {
      "type": "string",
      "enum": [
        "LearningJourney",
        "DevelopmentPlan"
      ],
      "description": "Original entity this record was migrated from (migration tracking)"
    },
    "source_id": {
      "type": "string",
      "description": "Original record ID this was migrated from (migration tracking, enables idempotent re-runs)"
    }
  },
  "required": [
    "title",
    "mode"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "Admin Level 1"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.author_email": "{{user.email}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.assigned_to_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "data.shared_admin_emails": {
            "$in": [
              "{{user.email}}"
            ]
          }
        },
        {
          "data.is_template": true
        },
        {
          "$and": [
            {
              "data.mode": "catalog"
            },
            {
              "data.status": "published"
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "User Level 2"
              }
            },
            {
              "data.user_email": "{{user.email}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Analyst"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": null,
    "delete": null
  }
}