{
  "name": "RoleRequirement",
  "type": "object",
  "description": "Canonical store for the role standard, belonging to a RoleSuccessBlueprint. Supports requirement types: competency, experience, credential, outcome, other. This is the general blueprint requirement store \u2014 CriticalRoleRequirement must NOT replace it. Approved requirements are immutable; changes create a new revision.",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Canonical tenant ID (sole partition key). Derived server-side."
    },
    "blueprint_id": {
      "type": "string",
      "description": "RoleSuccessBlueprint ID this requirement belongs to. Required. The blueprint owns the canonical requirement set."
    },
    "requirement_type": {
      "type": "string",
      "enum": [
        "competency",
        "experience",
        "credential",
        "outcome",
        "other"
      ],
      "description": "The type of requirement. competency = behavioral/technical competency. experience = required experience. credential = certification/qualification. outcome = required track record of outcomes. other = custom."
    },
    "requirement_text": {
      "type": "string",
      "description": "The requirement statement. Required."
    },
    "requirement_detail": {
      "type": "string",
      "description": "Optional elaboration of the requirement (e.g. proficiency level, specific credential name)."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "rejected",
        "withdrawn",
        "superseded"
      ],
      "default": "draft",
      "description": "Approval lifecycle. Approved requirements are immutable \u2014 modifications create a new revision via revises_requirement_id. superseded = replaced by a newer revision."
    },
    "revision_number": {
      "type": "number",
      "default": 1,
      "description": "Revision number. New revisions increment this. revises_requirement_id links to the prior revision."
    },
    "revises_requirement_id": {
      "type": "string",
      "description": "ID of the prior requirement revision this one replaces. Null for the first revision."
    },
    "source_blueprint_id": {
      "type": "string",
      "description": "For revisions: the RoleSuccessBlueprint ID from which the prior requirement was drawn. Null for first revision."
    },
    "source_blueprint_version": {
      "type": "number",
      "description": "For revisions: the OrgRole.blueprint_approval_revision at which the prior requirement was approved. Null for first revision."
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_by_profile_id": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by_profile_id": {
      "type": "string"
    },
    "rejected_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejected_by_profile_id": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "withdrawn_at": {
      "type": "string",
      "format": "date-time"
    },
    "withdrawn_by_profile_id": {
      "type": "string"
    },
    "withdrawal_reason": {
      "type": "string"
    },
    "confidentiality_level": {
      "type": "string",
      "enum": [
        "standard",
        "confidential",
        "highly_confidential",
        "legally_restricted"
      ],
      "default": "confidential"
    },
    "integrity_status": {
      "type": "string",
      "enum": [
        "pending_validation",
        "active",
        "quarantined",
        "resolved"
      ],
      "default": "active"
    },
    "quarantine_reason": {
      "type": "string"
    },
    "quarantined_at": {
      "type": "string",
      "format": "date-time"
    },
    "quarantined_by_operation_id": {
      "type": "string"
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "exception_found"
      ],
      "default": "pending"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by_profile_id": {
      "type": "string"
    },
    "resolution_rationale": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "blueprint_id",
    "requirement_type",
    "requirement_text",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.client_id}}"
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}