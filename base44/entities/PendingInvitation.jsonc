{
  "name": "PendingInvitation",
  "type": "object",
  "description": "The role an invited person should hold once they accept. The platform invitation itself only carries a built-in role (user or admin), so the app's own role (app_role) is recorded here at invite time and applied to the person's user record the first time they sign in. The record stays as a trail of who invited whom, in which role, and when.",
  "properties": {
    "email": {
      "type": "string",
      "description": "Email address that was invited (lower-cased)"
    },
    "app_role": {
      "type": "string",
      "description": "Role the person should hold once they sign in"
    },
    "client_id": {
      "type": "string",
      "description": "Tenant the person is being invited into"
    },
    "invited_by_email": {
      "type": "string",
      "description": "Email of the administrator who sent the invitation"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "claimed",
        "revoked"
      ],
      "default": "pending",
      "description": "pending = waiting for the person to sign in; claimed = the role has been applied; revoked = no longer to be applied"
    },
    "sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invitation was sent"
    },
    "claimed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the role was applied to the person's user record"
    }
  },
  "required": [
    "email",
    "app_role",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "Admin Level 1"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Partner Business Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    }
  }
}