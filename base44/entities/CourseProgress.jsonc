{
  "name": "CourseProgress",
  "type": "object",
  "description": "A learner's progress through one course, and the assignment that put it there. Completion state is owned by the learning record server, not the browser: learners can read their own row, but only administrators (and trusted server functions) can create or change one, so a completion cannot be fabricated or quietly edited. The assignment half of the row records why the learner has this course (basis), and any waiver or extension granted on it, with the reason and the approver kept so the decision can be reconstructed. The record itself is never deleted: when its retention window passes it is archived (retention_state) and stays readable, unless a legal hold is in place.",
  "properties": {
    "course_id": {
      "type": "string",
      "description": "ID of the Course"
    },
    "course_title": {
      "type": "string",
      "description": "Cached course title for display"
    },
    "learner_email": {
      "type": "string",
      "description": "Email of the learner"
    },
    "learner_name": {
      "type": "string",
      "description": "Name of the learner at the time of assignment, kept so the roster still reads sensibly after a name change"
    },
    "client_id": {
      "type": "string",
      "description": "Client ID for tenant scoping"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed"
      ],
      "default": "not_started",
      "description": "Current progress status"
    },
    "completed_lessons": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "lesson_id": {
            "type": "string"
          },
          "completed_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "description": "List of completed lessons with timestamps"
    },
    "overall_percentage": {
      "type": "number",
      "default": 0,
      "description": "Completion percentage 0-100"
    },
    "enrolled_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the learner was enrolled"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the learner completed the course"
    },
    "certificate_issued": {
      "type": "boolean",
      "default": false
    },
    "certificate_id": {
      "type": "string",
      "description": "ID of the issued certificate"
    },
    "cohort_id": {
      "type": "string",
      "description": "Cohort ID if cohort-paced"
    },
    "last_accessed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the learner last accessed the course"
    },
    "last_lesson_id": {
      "type": "string",
      "description": "Lesson the learner was last working on, used to resume at the right place"
    },
    "assigned_by": {
      "type": "string",
      "description": "Email of the person who assigned the course (empty for self-enrolment, 'system' for the recurring training refresh)"
    },
    "assignment_basis": {
      "type": "string",
      "enum": [
        "manual",
        "audience",
        "cohort",
        "self_enrolled",
        "open_access",
        "import",
        "recurring"
      ],
      "default": "manual",
      "description": "Why this learner has this course: picked by name, matched a role audience, came in with a cohort, enrolled themselves, took an open course, arrived by import, or is due a scheduled refresh. Recorded at assignment time and never inferred later."
    },
    "assignment_basis_label": {
      "type": "string",
      "maxLength": 500,
      "description": "Human-readable statement of the basis, shown on the roster (e.g. 'Role audience - 24 matched', 'Cohort: Q4 Managers')."
    },
    "assignment_basis_detail": {
      "type": "object",
      "additionalProperties": true,
      "description": "Structured detail behind the basis (audience criteria, cohort id and name, import source, refresh cycle), kept so the assignment can be explained precisely later."
    },
    "assignment_reason": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional note from the assigner on why this assignment was made"
    },
    "due_date": {
      "type": "string",
      "format": "date",
      "description": "Current due date for completing the course (moved when an extension is granted)"
    },
    "due_date_original": {
      "type": "string",
      "format": "date",
      "description": "The due date as first set, kept when an extension moves it, so the change is visible"
    },
    "extension_granted_days": {
      "type": "number",
      "default": 0,
      "description": "Total days of extension granted on this assignment, accumulated across grants"
    },
    "extension_reason": {
      "type": "string",
      "maxLength": 2000,
      "description": "Reason recorded when a due-date extension was last granted"
    },
    "extension_granted_by": {
      "type": "string",
      "description": "Email of the approver who granted the extension"
    },
    "extension_granted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the extension was granted"
    },
    "waiver_status": {
      "type": "string",
      "enum": [
        "none",
        "requested",
        "granted",
        "declined"
      ],
      "default": "none",
      "description": "State of a waiver on this assignment. 'granted' means the requirement no longer makes the learner overdue; the course itself stays available."
    },
    "waiver_reason": {
      "type": "string",
      "maxLength": 2000,
      "description": "Reason given for the waiver, by the learner when requesting or by the approver when granting"
    },
    "waiver_requested_at": {
      "type": "string",
      "format": "date-time"
    },
    "waiver_requested_by": {
      "type": "string"
    },
    "waiver_decided_at": {
      "type": "string",
      "format": "date-time"
    },
    "waiver_decided_by": {
      "type": "string",
      "description": "Email of the approver who granted or declined the waiver"
    },
    "waiver_decision_note": {
      "type": "string",
      "maxLength": 2000,
      "description": "Note recorded with the waiver decision"
    },
    "reminder_sent_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last due-date reminder was sent, so reminders are not repeated"
    },
    "legal_hold": {
      "type": "boolean",
      "default": false,
      "description": "When true this record is under legal hold: it is preserved and excluded from any retention archiving until the hold is released. Placing or releasing a hold requires a reason and is written to the append-only record."
    },
    "legal_hold_reason": {
      "type": "string",
      "maxLength": 2000,
      "description": "Reason recorded when the hold was placed or released"
    },
    "legal_hold_set_by": {
      "type": "string",
      "description": "Email of the administrator who placed the hold"
    },
    "legal_hold_set_at": {
      "type": "string",
      "format": "date-time"
    },
    "retention_state": {
      "type": "string",
      "enum": [
        "active",
        "archived"
      ],
      "default": "active",
      "description": "Whether the record is inside its retention window (active) or past it (archived). Archiving never deletes: the record and its history stay readable."
    },
    "retention_archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the record passed its retention window and was archived"
    },
    "retention_reason": {
      "type": "string",
      "maxLength": 1000,
      "description": "The retention rule applied when the record was archived"
    }
  },
  "required": [
    "course_id",
    "learner_email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 1"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Partner Business Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.learner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Analyst"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "User Level 2"
              }
            },
            {
              "data.learner_email": {
                "$in": "{{user.data.subordinate_emails}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 1"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Partner Business Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        }
      ]
    }
  }
}