{
  "name": "Permission",
  "type": "object",
  "properties": {
    "permission_key": {
      "type": "string",
      "description": "Unique key for this permission (e.g., 'users.view', 'classes.manage')"
    },
    "name": {
      "type": "string",
      "description": "Display name of the permission"
    },
    "description": {
      "type": "string",
      "description": "Description of what this permission allows"
    },
    "category": {
      "type": "string",
      "enum": [
        "users",
        "analytics",
        "content",
        "settings",
        "billing",
        "roles",
        "programs",
        "assessments",
        "learning",
        "goals",
        "classes",
        "coaching",
        "journeys",
        "certificates",
        "reports"
      ],
      "description": "Category this permission belongs to"
    },
    "is_system": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is a system-defined permission (cannot be deleted)"
    },
    "applies_to_roles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of app_role values this permission is relevant for"
    },
    "client_id": {
      "type": "string",
      "description": "Client that authored this permission (null for platform system permissions)"
    }
  },
  "required": [
    "permission_key",
    "name",
    "category"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.client_id": null
        },
        {
          "data.client_id": "{{user.data.client_id}}"
        },
        {
          "user_condition": {
            "data.app_role": "Platform Admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Platform Admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "data.app_role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "data.app_role": "Platform Admin"
          }
        }
      ]
    }
  }
}