{
  "name": "CriticalRole",
  "type": "object",
  "description": "Cycle-specific designation of an OrgPosition as critical for succession planning. One non-removed CriticalRole per client_id + cycle_id + org_position_id (enforced by successionDesignateCriticalRole). This is NOT a platform-default catalog entity \u2014 it is a tenant-scoped, cycle-bound designation.",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Canonical tenant ID (sole partition key). Derived server-side \u2014 never accepted from frontend input."
    },
    "cycle_id": {
      "type": "string",
      "description": "SuccessionCycle ID this designation belongs to. Required."
    },
    "org_position_id": {
      "type": "string",
      "description": "OrgPosition ID being designated as critical. Required. Must belong to the same tenant and cycle's role library."
    },
    "criticality_level": {
      "type": "string",
      "enum": [
        "critical",
        "high",
        "moderate"
      ],
      "default": "high",
      "description": "How critical this position is to organizational continuity."
    },
    "governance_tier": {
      "type": "string",
      "enum": [
        "executive",
        "senior",
        "operational"
      ],
      "default": "senior",
      "description": "Governance tier determines approval workflow depth."
    },
    "continuity_urgency": {
      "type": "string",
      "enum": [
        "immediate",
        "short_term",
        "long_term"
      ],
      "default": "short_term",
      "description": "How urgently a successor must be identified."
    },
    "designation_reason": {
      "type": "string",
      "description": "Human-readable reason for designating this position as critical."
    },
    "status": {
      "type": "string",
      "enum": [
        "designated",
        "active",
        "paused",
        "removed"
      ],
      "default": "designated",
      "description": "Designation lifecycle. 'designated' = newly created. 'active' = in use for succession planning. 'paused' = temporarily inactive. 'removed' = logically deleted (retained for audit)."
    },
    "designated_by_profile_id": {
      "type": "string",
      "description": "Profile ID of the user who designated this role. Derived server-side."
    },
    "designated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the designation was created. Set server-side."
    },
    "status_changed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the status was last changed. Set server-side."
    },
    "status_changed_by_profile_id": {
      "type": "string",
      "description": "Profile ID of the user who last changed the status. Derived server-side."
    },
    "status_change_reason": {
      "type": "string",
      "description": "Reason for the last status change (pause/remove)."
    },
    "confidentiality_level": {
      "type": "string",
      "enum": [
        "standard",
        "confidential",
        "highly_confidential",
        "legally_restricted"
      ],
      "default": "confidential",
      "description": "Standardized confidentiality level."
    },
    "integrity_status": {
      "type": "string",
      "enum": [
        "pending_validation",
        "active",
        "quarantined",
        "resolved"
      ],
      "default": "pending_validation",
      "description": "Integrity envelope status. New designations begin pending_validation; excluded from operational reads until active."
    },
    "quarantine_reason": {
      "type": "string"
    },
    "quarantined_at": {
      "type": "string",
      "format": "date-time"
    },
    "quarantined_by_operation_id": {
      "type": "string"
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "exception_found"
      ],
      "default": "pending"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by_profile_id": {
      "type": "string"
    },
    "resolution_rationale": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "cycle_id",
    "org_position_id",
    "criticality_level",
    "governance_tier",
    "continuity_urgency",
    "designation_reason",
    "status",
    "designated_by_profile_id",
    "designated_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__succession_control_plane_only__"
      }
    },
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.data.client_id}}"
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__succession_control_plane_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__succession_control_plane_only__"
      }
    }
  }
}