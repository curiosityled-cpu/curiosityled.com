{
  "name": "LearningCertificate",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the learner who earned the certificate"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the client (tenant) this certificate belongs to, kept so verification and reporting can stay tenant-scoped"
    },
    "certificate_type": {
      "type": "string",
      "enum": [
        "program_completion",
        "module_completion",
        "assessment_completion",
        "journey_completion",
        "course_completion"
      ],
      "description": "Type of achievement"
    },
    "program_id": {
      "type": "string",
      "description": "ID of the completed program (if applicable)"
    },
    "module_id": {
      "type": "string",
      "description": "ID of the completed module (if applicable)"
    },
    "journey_id": {
      "type": "string",
      "description": "ID of the completed journey (if applicable)"
    },
    "assessment_id": {
      "type": "string",
      "description": "ID of the passed assessment (if applicable)"
    },
    "title": {
      "type": "string",
      "description": "Certificate title (e.g., 'Leadership Fundamentals Completion')"
    },
    "description": {
      "type": "string",
      "description": "Description of what was achieved"
    },
    "issued_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the certificate was issued"
    },
    "certificate_url": {
      "type": "string",
      "description": "URL to the generated certificate PDF"
    },
    "verification_code": {
      "type": "string",
      "description": "Unique code for certificate verification"
    },
    "status": {
      "type": "string",
      "enum": [
        "valid",
        "revoked"
      ],
      "default": "valid",
      "description": "Whether the certificate still stands. A revoked certificate remains on record (never deleted) but verification reports it as revoked."
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the certificate was revoked"
    },
    "revoked_by": {
      "type": "string",
      "description": "Email of the administrator who revoked the certificate"
    },
    "revocation_reason": {
      "type": "string",
      "maxLength": 1000,
      "description": "Reason recorded with the revocation"
    },
    "competencies_demonstrated": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Competencies demonstrated through this achievement"
    },
    "final_score": {
      "type": "number",
      "description": "Final score or completion percentage"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Additional certificate metadata"
    }
  },
  "required": [
    "user_email",
    "certificate_type",
    "title",
    "issued_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "$or": [
                {
                  "data.client_id": null
                },
                {
                  "data.client_id": "{{user.data.client_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "$or": [
                {
                  "data.client_id": null
                },
                {
                  "data.client_id": "{{user.data.client_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "$or": [
                {
                  "data.client_id": null
                },
                {
                  "data.client_id": "{{user.data.client_id}}"
                }
              ]
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "User Level 2"
              }
            },
            {
              "data.user_email": {
                "$in": "{{user.data.subordinate_emails}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Analyst"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    }
  }
}