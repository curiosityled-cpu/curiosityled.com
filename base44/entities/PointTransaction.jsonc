{
  "name": "PointTransaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user receiving the points"
    },
    "given_by_email": {
      "type": "string",
      "description": "Email of the person who awarded the points (system, peer, manager, admin)"
    },
    "points_amount": {
      "type": "number",
      "description": "Number of points awarded (can be negative for deductions)"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "earned_activity",
        "peer_recognition",
        "manager_award",
        "admin_award",
        "system_award",
        "deduction"
      ],
      "description": "Type of point transaction"
    },
    "related_entity_type": {
      "type": "string",
      "description": "Type of entity related to this transaction (e.g., 'LearningResource', 'Goal', 'Assessment')"
    },
    "related_entity_id": {
      "type": "string",
      "description": "ID of the related entity"
    },
    "reason": {
      "type": "string",
      "description": "Text description of why points were awarded"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the client this transaction belongs to"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this point transaction"
    }
  },
  "required": [
    "user_email",
    "points_amount",
    "transaction_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "Admin Level 1"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Partner Business Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "data.given_by_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "User Level 2"
              }
            },
            {
              "data.user_email": {
                "$in": "{{user.data.subordinate_emails}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Analyst"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": null,
    "delete": null
  }
}