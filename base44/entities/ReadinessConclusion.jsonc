{
  "name": "ReadinessConclusion",
  "type": "object",
  "description": "A versioned, role-specific readiness conclusion for a SuccessorCandidacy, bound to its EffectiveBlueprintSnapshot at decision time. Proposed by an authorized tenant administrator, calibrated by a blind panel, and ratified by governance. No ranking, scoring, or automated recommendation. Ratified, overridden, and superseded historical conclusions are immutable. Returned conclusions create a new version via supersedes_conclusion_id.",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Canonical tenant ID (sole partition key). Derived server-side \u2014 never accepted from frontend input."
    },
    "candidacy_id": {
      "type": "string",
      "description": "SuccessorCandidacy ID this conclusion is for. Required."
    },
    "critical_role_id": {
      "type": "string",
      "description": "CriticalRole ID. Derived from the candidacy. Required."
    },
    "cycle_id": {
      "type": "string",
      "description": "SuccessionCycle ID. Derived from the candidacy. Required."
    },
    "effective_blueprint_snapshot_id": {
      "type": "string",
      "description": "EffectiveBlueprintSnapshot ID the candidacy is bound to. Derived from the candidacy. Required."
    },
    "version": {
      "type": "number",
      "description": "Version number. Increments on reconsideration. 1 for the first conclusion."
    },
    "proposed_value": {
      "type": "string",
      "enum": [
        "ready_now",
        "ready_with_conditions",
        "emerging",
        "insufficient_evidence",
        "not_aligned_now"
      ],
      "description": "The proposed readiness value. Required."
    },
    "calibrated_value": {
      "type": "string",
      "enum": [
        "ready_now",
        "ready_with_conditions",
        "emerging",
        "insufficient_evidence",
        "not_aligned_now"
      ],
      "description": "The panel-calibrated value. Null until calibration finalizes with quorum and concurrence."
    },
    "ratified_value": {
      "type": "string",
      "enum": [
        "ready_now",
        "ready_with_conditions",
        "emerging",
        "insufficient_evidence",
        "not_aligned_now"
      ],
      "description": "The governance-ratified value. Null until governance ratifies or overrides. Normal ratification uses calibrated_value; a different value requires decision=override."
    },
    "proposed_by_profile_id": {
      "type": "string",
      "description": "Profile ID of the proposer. Derived server-side."
    },
    "proposed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the proposal was submitted. Set server-side."
    },
    "missing_evidence": {
      "type": "string",
      "description": "Description of missing evidence gaps."
    },
    "conflicting_evidence": {
      "type": "string",
      "description": "Description of conflicting or contrary evidence."
    },
    "rationale": {
      "type": "string",
      "description": "Proposer rationale. Required at proposal submission."
    },
    "next_review_date": {
      "type": "string",
      "format": "date",
      "description": "Date by which this conclusion should be reviewed. Required at ratification."
    },
    "transition_horizon": {
      "type": "string",
      "enum": [
        "immediate",
        "0_6_months",
        "6_12_months",
        "12_24_months",
        "24_plus_months"
      ],
      "description": "Expected transition horizon if the candidate is selected."
    },
    "workflow_status": {
      "type": "string",
      "enum": [
        "draft",
        "proposed",
        "in_calibration",
        "awaiting_ratification",
        "ratified",
        "returned_for_evidence",
        "returned_for_recalibration",
        "overridden",
        "superseded",
        "withdrawn"
      ],
      "default": "draft",
      "description": "Conclusion lifecycle. draft = editable. proposed = frozen, awaiting calibration. in_calibration = panel reviewing. awaiting_ratification = calibrated, awaiting governance. ratified = governance-approved (immutable). returned_for_evidence/returned_for_recalibration = returned for rework (creates new version). overridden = governance overrode panel (immutable). superseded = replaced by a newer version. withdrawn = removed by proposer."
    },
    "supersedes_conclusion_id": {
      "type": "string",
      "description": "ID of the prior conclusion this one supersedes. Null for the first version."
    },
    "withdrawn_at": {
      "type": "string",
      "format": "date-time"
    },
    "withdrawn_by_profile_id": {
      "type": "string"
    },
    "confidentiality_level": {
      "type": "string",
      "enum": [
        "standard",
        "confidential",
        "highly_confidential",
        "legally_restricted"
      ],
      "default": "confidential"
    },
    "integrity_status": {
      "type": "string",
      "enum": [
        "pending_validation",
        "active",
        "quarantined",
        "resolved"
      ],
      "default": "pending_validation"
    },
    "quarantine_reason": {
      "type": "string"
    },
    "quarantined_at": {
      "type": "string",
      "format": "date-time"
    },
    "quarantined_by_operation_id": {
      "type": "string"
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "exception_found"
      ],
      "default": "pending"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by_profile_id": {
      "type": "string"
    },
    "resolution_rationale": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "candidacy_id",
    "critical_role_id",
    "cycle_id",
    "effective_blueprint_snapshot_id",
    "version",
    "proposed_value",
    "workflow_status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "data.client_id": "{{user.data.client_id}}"
            },
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.client_id": "{{user.data.client_id}}"
            },
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.client_id": "{{user.data.client_id}}"
            },
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "create": false,
    "update": false,
    "delete": false
  }
}