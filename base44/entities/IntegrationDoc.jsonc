{
  "name": "IntegrationDoc",
  "type": "object",
  "properties": {
    "integration_name": {
      "type": "string",
      "description": "Name of the integration (e.g., 'WIX', 'SCIM', 'IAM')"
    },
    "version": {
      "type": "string",
      "description": "Contract version (e.g., 'v1.0', 'v2.1')"
    },
    "title": {
      "type": "string",
      "description": "Document title"
    },
    "content": {
      "type": "string",
      "description": "Full contract content in markdown format"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this version is currently active"
    },
    "updated_by": {
      "type": "string",
      "description": "Email of admin who last updated this contract"
    }
  },
  "required": [
    "integration_name",
    "version",
    "title",
    "content"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "data.app_role": "Platform Admin"
      }
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "data.app_role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "data.app_role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "data.app_role": "Platform Admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "data.app_role": "Platform Admin"
      }
    },
    "delete": {
      "user_condition": {
        "data.app_role": "Platform Admin"
      }
    }
  }
}