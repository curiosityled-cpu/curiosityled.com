{
  "name": "HRBPDelegation",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "ID of the client (tenant) this delegation belongs to, stamped when the delegation is created"
    },
    "from_hrbp_email": {
      "type": "string",
      "description": "Email of the HRBP delegating their portfolio"
    },
    "to_hrbp_email": {
      "type": "string",
      "description": "Email of the backup HRBP receiving the delegation"
    },
    "scope": {
      "type": "string",
      "enum": [
        "all",
        "assignment"
      ],
      "default": "all",
      "description": "all = entire portfolio; assignment = a single portfolio assignment (use assignment_id)"
    },
    "assignment_id": {
      "type": "string",
      "description": "HRBPPortfolio ID being delegated (used when scope is 'assignment')"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Optional delegation start date. If null, active immediately."
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "Optional delegation end date. If null, open-ended until revoked."
    },
    "reason": {
      "type": "string",
      "enum": [
        "leave",
        "vacation",
        "termination",
        "other"
      ],
      "description": "Why the delegation was created"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active",
      "description": "active = delegation in effect; revoked = manually ended"
    },
    "created_by_email": {
      "type": "string",
      "description": "Who created the delegation (the HRBP themselves or an admin on their behalf)"
    },
    "notes": {
      "type": "string",
      "description": "Internal notes about this delegation"
    }
  },
  "required": [
    "from_hrbp_email",
    "to_hrbp_email",
    "scope"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.from_hrbp_email": "{{user.email}}"
        },
        {
          "data.to_hrbp_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.from_hrbp_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.from_hrbp_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.from_hrbp_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        }
      ]
    }
  }
}