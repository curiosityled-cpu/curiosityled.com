{
  "name": "SuccessionCycle",
  "type": "object",
  "description": "A succession planning cycle for a tenant. Lifecycle status (draft/active/paused/closed/archived) is SEPARATE from process_stage (the nine-stage methodology). updateDraftCycle may only modify draft-cycle fields; successionChangeCycleStatus handles lifecycle transitions. Process stage advancement is NOT done via updateDraftCycle.",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Canonical tenant ID (sole partition key). Derived server-side \u2014 never accepted from frontend input."
    },
    "cycle_key": {
      "type": "string",
      "description": "Unique cycle identifier within the tenant (e.g. '2026-Q4-succession'). Uniqueness-checked."
    },
    "name": {
      "type": "string",
      "description": "Human-readable cycle name"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "active",
        "paused",
        "closed",
        "archived"
      ],
      "default": "draft",
      "description": "Lifecycle status. draft = being configured. active = in use. paused = temporarily halted. closed = completed. archived = retained for history. Transitions via successionChangeCycleStatus only."
    },
    "process_stage": {
      "type": "string",
      "enum": [
        "frame",
        "focus",
        "blueprint",
        "discover",
        "evidence",
        "deliberate",
        "accelerate",
        "transition",
        "monitor"
      ],
      "default": "frame",
      "description": "Nine-stage methodology progress. Separate from lifecycle status. Advanced via a dedicated process-stage function, NOT via updateDraftCycle."
    },
    "process_stage_changed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the process stage was last advanced. Set server-side."
    },
    "process_stage_changed_by_profile_id": {
      "type": "string",
      "description": "Profile ID of the user who last advanced the process stage. Derived server-side."
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the cycle was started (status moved to active)."
    },
    "closed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the cycle was closed."
    },
    "archived_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the cycle was archived."
    },
    "created_by_profile_id": {
      "type": "string",
      "description": "Profile ID of the cycle creator. Derived server-side."
    },
    "confidentiality_level": {
      "type": "string",
      "enum": [
        "standard",
        "confidential",
        "highly_confidential",
        "legally_restricted"
      ],
      "default": "confidential"
    },
    "integrity_status": {
      "type": "string",
      "enum": [
        "pending_validation",
        "active",
        "quarantined",
        "resolved"
      ],
      "default": "pending_validation",
      "description": "Integrity envelope status. New uniqueness-checked records begin pending_validation; excluded from operational reads until active."
    },
    "quarantine_reason": {
      "type": "string"
    },
    "quarantined_at": {
      "type": "string",
      "format": "date-time"
    },
    "quarantined_by_operation_id": {
      "type": "string"
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "exception_found"
      ],
      "default": "pending"
    },
    "resolved_at": {
      "type": "string",
      "format": "date-time"
    },
    "resolved_by_profile_id": {
      "type": "string"
    },
    "resolution_rationale": {
      "type": "string"
    }
  },
  "required": [
    "client_id",
    "cycle_key",
    "name",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__succession_control_plane_only__"
      }
    },
    "read": {
      "$or": [
        {
          "data.client_id": "{{user.data.client_id}}"
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "__succession_control_plane_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__succession_control_plane_only__"
      }
    }
  }
}