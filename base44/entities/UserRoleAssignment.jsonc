{
  "name": "UserRoleAssignment",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Tenant ID"
    },
    "role_id": {
      "type": "string",
      "description": "ProvisioningRole ID"
    },
    "email": {
      "type": "string",
      "description": "User email (before linking)"
    },
    "base44_user_id": {
      "type": "string",
      "description": "Base44 User ID (after linking)"
    },
    "source_system": {
      "type": "string",
      "enum": [
        "WIX",
        "MANUAL",
        "IAM",
        "SCIM"
      ],
      "description": "System that created this assignment"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this user role assignment"
    }
  },
  "required": [
    "tenant_id",
    "role_id",
    "email"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.base44_user_id": "{{user.id}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.tenant_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.tenant_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Platform Admin"
              }
            },
            {
              "data.tenant_id": "{{user.data.client_id}}"
            }
          ]
        }
      ]
    },
    "update": null,
    "delete": null
  }
}