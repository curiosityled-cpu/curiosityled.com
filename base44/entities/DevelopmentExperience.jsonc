{
  "name": "DevelopmentExperience",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user this experience belongs to"
    },
    "coach_email": {
      "type": "string",
      "description": "Email of the Leadership Coach who created this coaching experience (set when a coach logs it for a coachee)"
    },
    "title": {
      "type": "string",
      "description": "Title of the development experience"
    },
    "description": {
      "type": "string",
      "description": "Description of what this experience involves"
    },
    "type": {
      "type": "string",
      "enum": [
        "leadership_coaching",
        "team_coaching",
        "workshop",
        "consultation",
        "assessment",
        "stretch_project",
        "leadership_opportunity",
        "mentorship",
        "conference_event",
        "volunteer_leadership",
        "cross_functional_project",
        "speaking_opportunity",
        "other"
      ],
      "description": "Type of development experience"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "planned",
      "description": "Current status of the experience"
    },
    "planned_month": {
      "type": "string",
      "description": "Month this is planned for (YYYY-MM format)"
    },
    "start_date": {
      "type": "string",
      "format": "date",
      "description": "Start date of the experience"
    },
    "end_date": {
      "type": "string",
      "format": "date",
      "description": "End date of the experience"
    },
    "competencies": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Competencies this experience develops"
    },
    "expected_impact": {
      "type": "number",
      "default": 5,
      "description": "Estimated competency score boost (percentage points)"
    },
    "provider_or_sponsor": {
      "type": "string",
      "description": "Name of the coaching firm, project sponsor, or organizer"
    },
    "reflection_notes": {
      "type": "string",
      "description": "User's notes or reflections on the experience"
    },
    "captured_goals": {
      "type": "array",
      "description": "Goals agreed upon during the coaching experience \u2014 captured here, not assigned. The coachee opts in to add them to their own goals.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "target_date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string",
            "enum": [
              "not_started",
              "in_progress",
              "achieved",
              "not_achieved",
              "deferred"
            ],
            "default": "not_started"
          },
          "linked_goal_id": {
            "type": "string",
            "description": "ID of the Goal created when the coachee adopted this captured goal"
          },
          "adopted_by_coachee": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "recommended_learning": {
      "type": "array",
      "description": "Learning resources recommended by the coach as part of this experience \u2014 not assigned. The coachee opts in to add them to their own learning.",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "resource_title": {
            "type": "string"
          },
          "resource_url": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "description": "Why the coach recommends this resource"
          },
          "linked_assigned_learning_id": {
            "type": "string",
            "description": "ID of the AssignedLearning created when the coachee adopted this recommendation"
          },
          "adopted_by_coachee": {
            "type": "boolean",
            "default": false
          }
        }
      }
    },
    "client_id": {
      "type": "string",
      "description": "Client ID for multi-tenant support"
    }
  },
  "required": [
    "user_email",
    "title",
    "type",
    "competencies"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Leadership Coach"
              }
            },
            {
              "data.coach_email": "{{user.email}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Leadership Coach"
              }
            },
            {
              "data.coach_email": "{{user.email}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "User Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Leadership Coach"
              }
            },
            {
              "data.coach_email": "{{user.email}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "Platform Admin"
      }
    }
  }
}