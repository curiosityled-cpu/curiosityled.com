{
  "name": "ExternalAssessmentResult",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who owns this result"
    },
    "assessment_type": {
      "type": "string",
      "description": "e.g., DiSC, MBTI, Situational Leadership (string for now, potential future entity)"
    },
    "designation_or_score": {
      "type": "string",
      "description": "e.g., ISFJ, D Profile, S3"
    },
    "date_completed": {
      "type": "string",
      "format": "date",
      "description": "Date the assessment was completed"
    },
    "document_uri": {
      "type": "string",
      "description": "URI to the uploaded private PDF report/image"
    },
    "ai_summary": {
      "type": "string",
      "description": "AI-generated summary of the result"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_ai_processing",
        "ai_processed",
        "needs_manual_input",
        "pending_human_review",
        "verified"
      ],
      "default": "pending_ai_processing",
      "description": "Processing status of the result"
    },
    "is_private": {
      "type": "boolean",
      "default": false,
      "description": "If true, only user and specific admins can view"
    },
    "verified_by": {
      "type": "string",
      "description": "Email of admin who verified this assessment"
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "description": "Timestamp when verification occurred"
    },
    "rejection_reason": {
      "type": "string",
      "description": "Reason for rejection if status is not verified"
    },
    "client_id": {
      "type": "string",
      "description": "Client ID for multi-tenant support"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this external assessment result"
    }
  },
  "required": [
    "user_email",
    "assessment_type",
    "client_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "User Level 2"
              }
            },
            {
              "data.user_email": {
                "$in": "{{user.data.subordinate_emails}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Analyst"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "user_condition": {
            "role": "Super Administrator"
          }
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        },
        {
          "$and": [
            {
              "data.is_private": false
            },
            {
              "user_condition": {
                "role": "User Level 2"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.is_private": false
            },
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "data.is_private": false
            },
            {
              "user_condition": {
                "role": "Analyst"
              }
            }
          ]
        }
      ]
    },
    "update": null,
    "delete": null
  }
}