{
  "name": "UserBadge",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who earned this badge"
    },
    "badge_template_id": {
      "type": "string",
      "description": "ID of the BadgeTemplate this instance represents"
    },
    "earned_date": {
      "type": "string",
      "format": "date-time",
      "description": "When this badge was earned"
    },
    "awarded_by_email": {
      "type": "string",
      "description": "Email of the person who manually awarded this badge (for manual awards)"
    },
    "client_id": {
      "type": "string",
      "description": "ID of the client this badge belongs to"
    },
    "progress_data": {
      "type": "object",
      "additionalProperties": true,
      "description": "Progress data at time of earning (for cumulative badges)"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional description of this user badge"
    }
  },
  "required": [
    "user_email",
    "badge_template_id",
    "earned_date"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.awarded_by_email": "{{user.email}}"
        },
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "Admin Level 1"
          }
        },
        {
          "user_condition": {
            "role": "Admin Level 2"
          }
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.user_email": "{{user.email}}"
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "User Level 2"
              }
            },
            {
              "data.user_email": {
                "$in": "{{user.data.subordinate_emails}}"
              }
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Analyst"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 1"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Admin Level 2"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Super Administrator"
              }
            },
            {
              "data.client_id": "{{user.data.client_id}}"
            }
          ]
        },
        {
          "$and": [
            {
              "user_condition": {
                "role": "Partner Business Administrator"
              }
            },
            {
              "data.client_id": {
                "$in": "{{user.data.partner_client_ids}}"
              }
            }
          ]
        },
        {
          "user_condition": {
            "role": "Platform Admin"
          }
        }
      ]
    },
    "update": null,
    "delete": null
  }
}