{
  "name": "Course Due-Date Reminders",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "course_due_date_reminders",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_course_reminders": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendCourseDueDateReminders",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Send course reminders",
            "description": "Due soon and overdue learners"
          }
        }
      }
    ]
  },
  "description": "Sends one due-soon or overdue reminder per course enrolment each morning",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "America/New_York",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}