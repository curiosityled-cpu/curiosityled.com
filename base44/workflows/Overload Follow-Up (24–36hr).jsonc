{
  "name": "Overload Follow-Up (24\u201336hr)",
  "description": "Triggers on ManagerPulse creation. If manager reported overload (operator_mode_response = very_much|somewhat), schedules 24\u201336hr follow-up pulse to check recovery.",
  "trigger": {
    "condition": "${ ((.trigger.data.operator_mode_response == \"very_much\") or (.trigger.data.operator_mode_response == \"somewhat\")) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "ManagerPulse"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "overload_follow_up_24_36hr",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "scheduleOverloadFollowUp",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "scheduleOverloadFollowUp"
  }
}