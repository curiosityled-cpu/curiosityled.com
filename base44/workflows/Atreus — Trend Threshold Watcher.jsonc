{
  "name": "Atreus \u2014 Trend Threshold Watcher",
  "description": "",
  "trigger": {
    "condition": "${ (.trigger.changed_fields | index(\"overload_pattern_strength\") != null) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "ManagerTrends"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "atreus_trend_threshold_watcher",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "atreusOrchestrator",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "atreusOrchestrator"
  }
}