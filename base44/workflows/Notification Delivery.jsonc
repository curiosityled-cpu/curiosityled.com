{
  "name": "Notification Delivery",
  "description": "Delivers due notifications every 15 minutes, following the organization's channel and cadence settings.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notification_delivery",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "deliver_notifications": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "processScheduledNotifications",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Deliver due notifications",
            "description": "Honours channel and cadence settings"
          }
        }
      }
    ]
  }
}